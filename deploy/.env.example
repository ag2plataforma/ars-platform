# Copia a deploy/.env (chmod 600) y completa. NUNCA se sube a git.
# Generar secretos:  openssl rand -hex 32     (hex evita caracteres raros en URLs)

# --- Dominio y HTTPS ---------------------------------------------------------
DOMAIN=app.tudominio.com
ACME_EMAIL=tu-correo@tudominio.com

# --- Postgres (contenedor en la VPS) -----------------------------------------
POSTGRES_PASSWORD=
POSTGRES_DB=ars

# --- Seguridad ---------------------------------------------------------------
# Un unico secreto compartido por todos los servicios y el gateway.
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_EXTENDED_EXPIRES_IN=90d

# --- Correo (Brevo) -- iam (reset de clave) y documents (envio de correos) ----
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=ARS Platform

# --- Pagos -------------------------------------------------------------------
# sandbox = pasarela simulada interna; stripe = Stripe real.
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_LINK_TTL_DAYS=7

# --- IA (extraccion de documentos / siniestros) ------------------------------
AI_ENABLED=true
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MAX_FILE_MB=10

# --- Colectivos --------------------------------------------------------------
COLLECTIVE_MAX_INSUREDS=100

# --- SMS (Twilio) -- documents ------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TRIAL_TEMPLATE=
SMS_SENDER_NAME=ARS
SMS_DEFAULT_COUNTRY_CODE=

# --- Impacto social ----------------------------------------------------------
EMISSIONS_DEV_API_KEY=
EMISSIONS_DEV_BASE_URL=https://api.emissions.dev/v1

# --- Backups (opcional: copia fuera de la VPS con rclone) --------------------
# Ej.: BACKUP_RCLONE_REMOTE=b2:mi-bucket/ars-backups   (rclone config previo)
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14
