# DOMAIN y ACME_EMAIL llegan como variables de entorno (ver deploy/.env).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Registro de accesos en stdout (docker compose logs web): imprescindible para
	# depurar webhooks (Stripe) y ver que ruta/metodo llega realmente.
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API: el frontend llama a /api/<servicio>/...; el gateway no usa prefijo,
	# asi que handle_path quita "/api" antes de reenviar. Incluye el webhook de
	# Stripe: https://<dominio>/api/underwriting/public/payments/webhook/stripe
	handle_path /api/* {
		reverse_proxy gateway:3000
	}

	# SPA Angular: cualquier ruta que no sea un archivo cae en index.html.
	#
	# Cache: los bundles de Angular llevan hash en el nombre (main-XXXX.js,
	# styles-XXXX.css) y pueden cachearse un año; todo lo demas (index.html,
	# i18n/*.json, imagenes de public/) conserva el mismo nombre entre versiones
	# y debe revalidarse siempre (ETag -> 304 si no cambio), si no el navegador
	# sigue usando traducciones o imagenes viejas tras un despliegue.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		@hashed path_regexp ^/[^/]+-[A-Za-z0-9]+\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
