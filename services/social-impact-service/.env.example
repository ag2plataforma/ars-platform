PORT=3008
DATABASE_URL=postgresql://user:password@localhost:5432/ars_platform?schema=ars_platform

# Este servicio NO emite tokens (eso solo lo hace iam-service) — solo los
# verifica, así que JWT_SECRET debe ser EXACTAMENTE el mismo valor que el
# .env de iam-service, o los tokens que emita iam-service no validarán aquí.
JWT_SECRET=change-me

# emissions.dev (Etapa 2 -- huella de carbono por electricidad). Nivel
# gratis: 500 requests/mes, sin tarjeta, utilizable en produccion. Cada
# desarrollador registra su propia cuenta/API key en https://emissions.dev
# -- NUNCA commitear un valor real aca, este archivo es el template.
# Si se deja vacio, el calculo de electricidad se omite (degradacion
# elegante: kg CO2 = 0 para ese componente, con electricityDataAvailable
# = false en el resultado) en vez de fallar el calculo completo.
EMISSIONS_DEV_API_KEY=
EMISSIONS_DEV_BASE_URL=https://api.emissions.dev/v1
