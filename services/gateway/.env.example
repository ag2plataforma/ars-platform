PORT=3000

# Este servicio NO emite tokens (eso solo lo hace iam-service) — solo los
# verifica/propaga, así que JWT_SECRET debe ser EXACTAMENTE el mismo valor que el
# .env de iam-service, o los tokens que emita iam-service no validarán aquí.
JWT_SECRET=change-me

# URLs reales de cada servicio de negocio (ver services/gateway/src/proxy/proxy.config.ts).
# En desarrollo, los valores por defecto (localhost + puerto propio de cada
# servicio) alcanzan sin definir nada acá -- solo hace falta fijarlas en
# producción (Render, Oracle, etc.), una por servicio desplegado.
IAM_SERVICE_URL=http://localhost:3001
PRODUCT_RATING_SERVICE_URL=http://localhost:3002
PARTY_SERVICE_URL=http://localhost:3003
REFERENCE_DATA_SERVICE_URL=http://localhost:3004
UNDERWRITING_SERVICE_URL=http://localhost:3005
CLAIMS_SERVICE_URL=http://localhost:3006
BILLING_SERVICE_URL=http://localhost:3007
