PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/ars_platform?schema=entity
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
JWT_EXTENDED_EXPIRES_IN=90d

# Recuperación de contraseña (POST /auth/forgot-password)
BREVO_API_KEY=your-brevo-api-key
EMAIL_SENDER_ADDRESS=no-reply@yourdomain.com
EMAIL_SENDER_NAME=ARS Platform
# A dónde apunta el link del correo — hoy no hay frontend sirviendo esta
# ruta, así que el valor real solo importa cuando exista una página que
# lea ?token= y llame a POST /auth/reset-password.
PASSWORD_RESET_URL_BASE=http://localhost:4200/reset-password
