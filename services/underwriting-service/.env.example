PORT=3005
DATABASE_URL=postgresql://user:password@localhost:5432/ars_platform?schema=ars_platform

# Este servicio NO emite tokens (eso solo lo hace iam-service) — solo los
# verifica, así que JWT_SECRET debe ser EXACTAMENTE el mismo valor que el
# .env de iam-service, o los tokens que emita iam-service no validarán aquí.
JWT_SECRET=change-me

# social-impact-service (Etapa 2 de Impacto Social, ver docs/02-roadmap.md)
# -- llamada HTTP real para el calculo de CFP/SIP/score/% de ajuste.
SOCIAL_IMPACT_SERVICE_URL=http://localhost:3008

# documents-service (correo de bienvenida con la póliza adjunta al
# activar un contrato, ver ContractsService.activate) -- misma llamada
# HTTP real entre servicios que SOCIAL_IMPACT_SERVICE_URL arriba.
DOCUMENTS_SERVICE_URL=http://localhost:3009

# Cobranza (landing de pago, ver docs/02-roadmap.md "Cobranza y activación con pago").
# Pasarela: `sandbox` = pasarela SIMULADA para pruebas (sin cuenta ni cobro real);
# `stripe` = Stripe Checkout real. Vacío/otro valor => la landing responde 503 al ir a pagar.
PAYMENT_PROVIDER=sandbox

# Solo con PAYMENT_PROVIDER=stripe (las credenciales viven ÚNICAMENTE aquí, nunca en git).
# Clave secreta de Dashboard > Desarrolladores > Claves de API (sk_test_... en pruebas).
STRIPE_SECRET_KEY=
# Secreto de firma del endpoint de webhook (whsec_...), de Dashboard > Webhooks.
# Endpoint: <URL pública del gateway>/underwriting/public/payments/webhook/stripe
# con los eventos checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed y checkout.session.expired.
# Sin él, el webhook se rechaza, pero el pago igualmente se confirma al volver a la landing.
STRIPE_WEBHOOK_SECRET=
# URL pública del frontend (se usa en el enlace del correo y en la pasarela simulada).
PUBLIC_APP_URL=http://localhost:4200
# Días de validez del enlace de pago.
PAYMENT_LINK_TTL_DAYS=7

# IA (Fase 4: extracción de datos de documentos de requisitos). La IA solo PROPONE,
# una persona confirma; cada llamada queda registrada en TAiRequest.
# Interruptor general: false apaga la IA por completo.
AI_ENABLED=true
# `anthropic` (API de Claude) o `mock` (datos simulados, sin clave ni coste).
# Si se omite: anthropic cuando hay ANTHROPIC_API_KEY, desactivada si no.
AI_PROVIDER=mock
# Solo con AI_PROVIDER=anthropic (la clave vive ÚNICAMENTE aquí, nunca en git).
ANTHROPIC_API_KEY=
# Modelo a usar (por defecto claude-sonnet-5-5).
ANTHROPIC_MODEL=
# Tamaño máximo (MB) de documento que se envía a la IA (por defecto 10).
AI_MAX_FILE_MB=10
