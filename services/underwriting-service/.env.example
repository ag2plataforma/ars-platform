PORT=3005
DATABASE_URL=postgresql://user:password@localhost:5432/ars_platform?schema=ars_platform

# Este servicio NO emite tokens (eso solo lo hace iam-service) — solo los
# verifica, así que JWT_SECRET debe ser EXACTAMENTE el mismo valor que el
# .env de iam-service, o los tokens que emita iam-service no validarán aquí.
JWT_SECRET=change-me

# social-impact-service (Etapa 2 de Impacto Social, ver docs/02-roadmap.md)
# -- llamada HTTP real para el calculo de CFP/SIP/score/% de ajuste.
SOCIAL_IMPACT_SERVICE_URL=http://localhost:3008
