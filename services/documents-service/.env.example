PORT=3009
DATABASE_URL=postgresql://user:password@localhost:5432/ars_platform?schema=entity

# Este servicio NO emite tokens (eso solo lo hace iam-service) — solo los
# verifica, así que JWT_SECRET debe ser EXACTAMENTE el mismo valor que el
# .env de iam-service, o los tokens que emita iam-service no validarán aquí.
JWT_SECRET=change-me

# Directorio temporal donde se arma el .docx mergeado y el .pdf resultante
# antes de guardar los bytes en Postgres -- se borra apenas termina cada
# generación. Default: carpeta temporal del sistema operativo.
DOCUMENTS_TMP_DIR=

# Correo de bienvenida con la póliza adjunta al activar un contrato
# (ver GenerationService.generateWelcomeEmail) -- mismo proveedor (Brevo)
# y mismas variables que ya usan iam-service/underwriting-service.
BREVO_API_KEY=change-me
EMAIL_SENDER_ADDRESS=change-me
EMAIL_SENDER_NAME=ARS Platform

# SMS: proveedor "twilio", "brevo" o "log" (log = no envía, solo escribe el SMS en el log; para desarrollo).
# Si se omite: twilio cuando hay TWILIO_ACCOUNT_SID, si no brevo.
SMS_PROVIDER=twilio
# Twilio (cuenta trial: solo envía a números verificados en la consola)
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
# Número de Twilio en E.164 (o usar TWILIO_MESSAGING_SERVICE_SID=MG...)
TWILIO_FROM=+15551234567
# Solo cuenta trial de Twilio: no admite texto propio ni From; se envía esta plantilla predefinida
# (ej. sms_account_alerts). Quitar al mejorar la cuenta.
TWILIO_TRIAL_TEMPLATE=
# Brevo SMS: usa BREVO_API_KEY; remitente de hasta 11 caracteres
SMS_SENDER_NAME=ARS
# Código de país (solo dígitos) para celulares guardados sin prefijo internacional, ej. 507
SMS_DEFAULT_COUNTRY_CODE=
