PORT=3006
DATABASE_URL=postgresql://user:password@localhost:5432/ars_platform?schema=ars_platform

# Este servicio NO emite tokens (eso solo lo hace iam-service) — solo los
# verifica, así que JWT_SECRET debe ser EXACTAMENTE el mismo valor que el
# .env de iam-service, o los tokens que emita iam-service no validarán aquí.
JWT_SECRET=change-me

# IA (Fase 4: extracción de documentos y triage de siniestros). La IA solo PROPONE,
# una persona confirma; cada llamada queda registrada en TAiRequest.
# Interruptor general: false apaga la IA por completo.
AI_ENABLED=true
# `anthropic` (API de Claude) o `mock` (datos simulados, sin clave ni coste).
# Si se omite: anthropic cuando hay ANTHROPIC_API_KEY, desactivada si no.
AI_PROVIDER=mock
# Solo con AI_PROVIDER=anthropic (la clave vive ÚNICAMENTE aquí, nunca en git).
ANTHROPIC_API_KEY=
# Modelo a usar (por defecto claude-sonnet-5-5).
ANTHROPIC_MODEL=
# Tamaño máximo (MB) de documento que se envía a la IA (por defecto 10).
AI_MAX_FILE_MB=10
